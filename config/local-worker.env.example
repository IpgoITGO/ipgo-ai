# DA-01 로컬 시험 전용 예시. 실제 환경을 만들지 않습니다.
# 복사 후 docs/local-worker.md에 따라 Server·Infra와 대조하고 값을 채웁니다.
ENGINE_MODE=real
# 모든 연결 대상 확인 전에는 켜지 않습니다.
IPGO_EMBEDDED_WORKER_ENABLED=false

# 시험 전용 DB의 read-only DSN 필수. 비워 두면 DB 소유권 검증을 건너뛰므로 통합 시험 불가.
DATABASE_URL=
# 파일 원본 모드: Server 원본 트리를 AI 프로세스에서 읽는 절대 경로.
STORAGE_BASE=
IPGO_UPLOAD_BUCKET=
# db/ 원본 모드는 기본안에서 제외. 선택 시 별도 Server view/role 계약 필요.
IPGO_ORIGINAL_DATABASE_URL=

AWS_REGION=ap-northeast-2
# 이 loopback 주소는 예시이며 Infra가 준비한 로컬 브로커 주소로 대조합니다.
AWS_ENDPOINT_URL_SQS=http://127.0.0.1:9324
# 브로커가 돌려준 시험 jobs/results URL을 각각 채웁니다. 서로 달라야 합니다.
IPGO_JOBS_QUEUE_URL=
IPGO_RESULTS_QUEUE_URL=
# 실제 AWS 권한이 없는 로컬 서명용 가짜 값입니다. 실 AWS key로 바꾸지 않습니다.
AWS_ACCESS_KEY_ID=local-test-only
AWS_SECRET_ACCESS_KEY=local-test-only
AWS_EC2_METADATA_DISABLED=true
# app.config의 자동 .env 로딩을 막습니다. dotenv CLI는 지정 파일만 읽습니다.
PYTHON_DOTENV_DISABLED=1
# 로컬 정제 시험에서 유료 LLM을 사용하지 않습니다.
OPENAI_API_KEY=
