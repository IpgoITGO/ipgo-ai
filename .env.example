# 복사해서 .env로 쓰고, 실제 값은 commit하지 않습니다.

# mock: API 명세 예시 응답 · real: 실제 계산
ENGINE_MODE=mock

# API 내부 worker는 기본 OFF. 로컬 연동은 docs/local-worker.md의 격리 확인 후 실행합니다.
IPGO_EMBEDDED_WORKER_ENABLED=false
# SQS 호환 로컬 endpoint는 config/local-worker.env.example을 참고합니다.
# 실제 AWS 사용 시 AWS_ENDPOINT_URL_SQS를 임의로 설정하지 않습니다.

# 계산 엔진 DB 연결 (읽기 전용). 방식 확정 전에는 비워 둡니다.
DATABASE_URL=

# 원본 엑셀 저장 위치. 방식 확정 전에는 비워 둡니다.
STORAGE_BASE=
AWS_REGION=ap-northeast-2
IPGO_UPLOAD_BUCKET=
IPGO_JOBS_QUEUE_URL=
IPGO_RESULTS_QUEUE_URL=

# AI 인사이트 (이석형)
OPENAI_API_KEY=
# LLM 모델 (docs/ai-insight/llm-model-selection.md). 비워 두면 gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# LLM 호출 한 번을 기다리는 최대 시간(초). 비워 두면 10 (명세 7장 미결)
LLM_TIMEOUT_SEC=10
